---
import { Button, DocsLayout, Hero, Section, SectionHeader } from '@deramond.dev/astro';
import ComponentAnatomy from '@component-anatomy/astro/ComponentAnatomy.astro';
import Slider from '../components/Slider.astro';
import type { AnatomyPartDefinition } from '@component-anatomy/core';

import hero from '../brand/hero.svg';
import { GITHUB, NPM } from '../sidebar.mjs';
import '../styles/anatomy.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const sliderParts: AnatomyPartDefinition[] = [
  { id: 'root', name: 'Root', description: 'The component wrapper — groups every part below.' },
  { id: 'track', name: 'Track', description: 'The rail the thumb travels along.' },
  { id: 'range', name: 'Range', description: 'The filled portion, visualizing the current value.' },
  { id: 'thumb', name: 'Thumb', description: 'The draggable handle. Focusable, arrow-key operable.' },
  { id: 'output', name: 'Output', description: 'Live value readout, announced via `aria-live`.' },
];

const features = [
  {
    icon: 'M12 2v4m0 12v4M2 12h4m12 0h4',
    title: 'Framework-agnostic core',
    desc: 'A dependency-free ~4 kB runtime. Works in plain HTML, any bundler, any framework — anywhere a DOM exists.',
  },
  {
    icon: 'M8 3 4 7l4 4M16 21l4-4-4-4M4 7h16M20 17H4',
    title: 'Two-way hover sync',
    desc: 'Hover docs → highlight the component. Hover the component → highlight the docs. Always in sync.',
  },
  {
    icon: 'M12 3v18m9-9H3',
    title: 'One attribute',
    desc: 'Annotate elements with data-part="thumb". Parts are auto-discovered, names derived from ids.',
  },
  {
    icon: 'M12 2a7 7 0 0 0-7 7c0 2.4 1.2 4.5 3 5.7V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.3c1.8-1.2 3-3.3 3-5.7a7 7 0 0 0-7-7z',
    title: 'Themable rendering',
    desc: 'Four presets, one-line accent theming, CSS variables, render hooks. Beautiful defaults, full control.',
  },
  {
    icon: 'M9 3H5a2 2 0 0 0-2 2v4m18 0V5a2 2 0 0 0-2-2h-4m0 18h4a2 2 0 0 0 2-2v-4M3 15v4a2 2 0 0 0 2 2h4',
    title: 'Live overlays',
    desc: 'Highlight boxes track the real rendered DOM — resize, scroll, dynamic updates included.',
  },
  {
    icon: 'M12 8V4H8m8 8h4v-4M8 16H4v4m12-4h4v4',
    title: 'Astro & Storybook',
    desc: 'A drop-in Astro component with SSR Markdown, and a Storybook addon panel for any renderer.',
  },
];

const packages = [
  {
    name: '@component-anatomy/core',
    href: 'docs/core',
    desc: 'The runtime: createAnatomy(), overlays, theming, events.',
  },
  {
    name: '@component-anatomy/astro',
    href: 'docs/astro',
    desc: 'Two-column anatomy block with SSR Markdown descriptions.',
  },
  {
    name: '@component-anatomy/storybook',
    href: 'docs/storybook',
    desc: 'An "Anatomy" panel synced with the story canvas. SB 10/11.',
  },
];
---

<DocsLayout title="Interactive component anatomy docs" wide footer={{ left: 'MIT © Julien Déramond' }}>
  <a slot="links" href={GITHUB}>GitHub</a>

  <Hero eyebrow={{ label: 'MIT · Framework-agnostic' }} image={hero}>
    <Fragment slot="title">Component anatomy docs<br /><em class="d-cy">that are actually alive</em></Fragment>
    <p class="d-lead sub">
      Stop exporting annotated screenshots from Figma. Annotate your rendered
      DOM with <code>data-part</code> and get an interactive, synchronized
      anatomy panel — in plain HTML, Astro, or Storybook.
    </p>
    <Fragment slot="actions">
      <Button variant="gold" href={`${base}docs/core/`}>Get started →</Button>
      <Button href={GITHUB}>Star on GitHub</Button>
    </Fragment>
    <pre slot="after" class="snippet"><code><span class="tk-c">// 1. Annotate your component</span>
&lt;div class="thumb" <span class="tk-a">data-part="thumb"</span>&gt;&lt;/div&gt;

<span class="tk-c">// 2. Wire it up</span>
<span class="tk-k">import</span> {'{ createAnatomy }'} <span class="tk-k">from</span> <span class="tk-s">'@component-anatomy/core'</span>;
<span class="tk-f">createAnatomy</span>({'{ root, panel }'});</code></pre>
  </Hero>

  <Section grid>
    <SectionHeader
      num="01"
      label="Try it — this is real"
      title="Hover the docs. Hover the component."
      lead="This slider is a live component on this page, documented by the library itself."
    />
    <div class="d-specimen demo">
      <ComponentAnatomy parts={sliderParts}>
        <Slider />
      </ComponentAnatomy>
    </div>
    <p class="more">
      More demos:
      <a href={`${base}theming/`}>presets &amp; theming</a> ·
      <a href={`${base}bs-button/`}>Bootstrap via CDN</a> ·
      <a href={`${base}shadcn/`}>shadcn-style</a> ·
      <a href={`${base}storybook/`}>Storybook addon ↗</a>
    </p>
  </Section>

  <Section>
    <SectionHeader num="02" label="Why" title="Small API, serious rendering" />
    <ul class="features">
      {features.map((f) => (
        <li>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon} /></svg>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <SectionHeader num="03" label="Packages" title="Pick your entry point" />
    <ul class="packages">
      {packages.map((p) => (
        <li>
          <a class="d-cut" href={`${base}${p.href}/`}>
            <code>{p.name}</code>
            <p>{p.desc}</p>
            <span class="d-mono">Read the docs →</span>
          </a>
        </li>
      ))}
    </ul>
    <nav class="links d-mono" aria-label="Project">
      <a href={`${base}docs/core/`}>Docs</a>
      <a href={`${base}docs/faq/`}>FAQ</a>
      <a href={GITHUB}>GitHub</a>
      <a href={NPM}>npm</a>
    </nav>
  </Section>
</DocsLayout>

<style>
  .sub { font-size: 1.1875rem; max-width: 52ch; }

  /* The hero snippet, coloured like the site's code blocks. */
  .snippet { margin-top: var(--space-8); max-width: 34rem; }
  .tk-c { color: var(--color-muted); font-style: italic; }
  .tk-a { color: var(--color-primary-lift); }
  .tk-k { color: var(--color-illustration-azure); }
  .tk-s { color: var(--color-illustration-rose); }
  .tk-f { color: var(--color-primary-lift); }

  .demo { margin-top: var(--space-8); }
  .more { margin: var(--space-6) 0 0; color: var(--color-muted); }

  .features, .packages { list-style: none; margin: var(--space-8) 0 0; padding: 0; display: grid; gap: var(--space-5); }
  @media (min-width: 720px) {
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .packages { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 980px) { .features { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .features li { border-top: var(--stroke-hairline) solid var(--color-line); padding-top: var(--space-5); }
  .features svg { color: var(--color-primary); }
  .features h3 { font-size: var(--font-size-base); margin: var(--space-3) 0 var(--space-2); }
  .features p { color: var(--color-muted); margin: 0; }

  .packages a {
    display: flex; flex-direction: column; gap: var(--space-3); height: 100%;
    padding: var(--space-5); background: var(--color-panel); border: var(--stroke-hairline) solid var(--color-line);
    color: var(--color-fg);
  }
  .packages a:hover { border-color: var(--color-primary); }
  .packages code { background: none; border: 0; padding: 0; font-size: var(--font-size-md); color: var(--color-fg); }
  .packages p { color: var(--color-muted); margin: 0; flex: 1; }
  .packages span { color: var(--color-primary); font-size: var(--font-size-sm); }

  .links { display: flex; flex-wrap: wrap; gap: var(--space-5); margin-top: var(--space-10); font-size: var(--font-size-sm); }
</style>
