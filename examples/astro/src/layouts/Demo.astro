---
/**
 * A demo page in the docs shell: same sidebar as the docs (src/sidebar.mjs), previous and next
 * across docs and demos, the title as the page heading and the `lead` slot under it.
 *
 * The demos are the product at work, so everything in the default slot is a specimen: the site's
 * element styles stop there, and the anatomy block and the demo components bring their own.
 * `bootstrap` loads Bootstrap's CSS from the CDN for that page only, in a cascade layer so it can
 * never restyle the site around the demo, and renders the demo in Bootstrap's dark mode.
 */
import { DocsLayout } from '@deramond.dev/astro';
import { buildSidebar } from '@deramond.dev/astro/docs';
import { getCollection } from 'astro:content';

import { sidebar as groups } from '../sidebar.mjs';
import '../styles/anatomy.css';

interface Props {
  title: string;
  bootstrap?: boolean;
}

const { title, bootstrap = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const sidebar = buildSidebar(await getCollection('docs'), { base, route: 'docs', group: 'Docs', sidebar: groups });

// Previous and next walk the site's own pages in sidebar order, not the external links.
const here = Astro.url.pathname.replace(/\/?$/, '/');
const pages = sidebar.flatMap((g) => g.items).filter((i) => i.href.startsWith('/') && !i.href.endsWith('/storybook/'));
const at = pages.findIndex((i) => i.href === here);
const [prev, next] = [pages[at - 1], pages[at + 1]];

const lead = Astro.slots.has('lead') ? await Astro.slots.render('lead') : '';
const description = lead.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim() || undefined;
---
<DocsLayout title={title} description={description} heading={title} sidebar={sidebar} prev={prev} next={next}>
  {bootstrap && (
    <style is:inline slot="head">@import url('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css') layer(specimen);</style>
  )}
  {lead && <p class="d-lead" set:html={lead} />}
  <div class:list={['d-specimen', 'demo', { 'demo--bootstrap': bootstrap }]} data-bs-theme={bootstrap ? 'dark' : undefined}>
    <slot />
  </div>
</DocsLayout>

<style>
  .d-lead { margin-bottom: var(--space-8); }

  /* Bootstrap components read their type and colour from <body>, which is the site's here. */
  .demo--bootstrap :global(.ca-preview-inner) {
    font-family: var(--bs-body-font-family);
    font-size: var(--bs-body-font-size);
    line-height: var(--bs-body-line-height);
    color: var(--bs-body-color);
  }
</style>
