{
  "name": "@component-anatomy/storybook",
  "version": "0.4.0",
  "description": "Storybook addon — interactive component anatomy panel synced with the story canvas",
  "license": "MIT",
  "author": "Julien Déramond",
  "homepage": "https://github.com/julien-deramond/component-anatomy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-deramond/component-anatomy",
    "directory": "packages/storybook"
  },
  "bugs": {
    "url": "https://github.com/julien-deramond/component-anatomy/issues"
  },
  "keywords": [
    "storybook-addon",
    "component-anatomy",
    "design-system",
    "documentation",
    "anatomy",
    "appearance",
    "mdx",
    "storybook-docs"
  ],
  "storybook": {
    "displayName": "Component Anatomy",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "html"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "default": "./dist/blocks.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "default": "./dist/manager.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node ../../scripts/typecheck-fixture.mjs test/consumer-types.ts && node ../../scripts/typecheck-fixture.mjs test/consumer-blocks-types.tsx && node ../../scripts/typecheck-fixture.mjs test/consumer-csf-next-types.ts"
  },
  "dependencies": {
    "@component-anatomy/core": "workspace:^"
  },
  "devDependencies": {
    "@storybook/addon-docs": "11.0.0-alpha.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "11.0.0-alpha.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^10.0.0 || ^11.0.0-0",
    "react": ">=18",
    "storybook": "^10.0.0 || ^11.0.0-0"
  },
  "peerDependenciesMeta": {
    "@storybook/addon-docs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
