{
  "name": "@component-anatomy/storybook",
  "version": "0.0.2",
  "description": "Storybook addon — interactive component anatomy panel synced with the story canvas",
  "license": "MIT",
  "author": "Julien Déramond",
  "homepage": "https://github.com/julien-deramond/component-anatomy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-deramond/component-anatomy",
    "directory": "packages/storybook"
  },
  "bugs": {
    "url": "https://github.com/julien-deramond/component-anatomy/issues"
  },
  "keywords": [
    "storybook-addon",
    "component-anatomy",
    "design-system",
    "documentation",
    "anatomy",
    "appearance",
    "mdx",
    "storybook-docs"
  ],
  "storybook": {
    "displayName": "Component Anatomy",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "html"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./manager": "./dist/manager.js",
    "./preview": "./dist/preview.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node ../../scripts/typecheck-fixture.mjs test/consumer-types.ts && node ../../scripts/typecheck-fixture.mjs test/consumer-blocks-types.tsx"
  },
  "dependencies": {
    "@component-anatomy/core": "workspace:^"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.2",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@storybook/addon-docs": ">=9.0.0",
    "react": ">=18",
    "storybook": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@storybook/addon-docs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
